# Clerk (from dashboard / clerk init)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional AI / YouTube
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Supabase Storage (PDF uploads — free plan)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose as NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Optional (default: class-materials). Create public bucket in Storage.
SUPABASE_STORAGE_BUCKET=class-materials
